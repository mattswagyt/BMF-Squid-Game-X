local function getKillRemotes()
    local remotes = {}
    local searched = {}

    local function scanFolder(container)
        if not container or searched[container] then return end
        searched[container] = true
        for _, obj in ipairs(container:GetChildren()) do
            if obj:IsA("RemoteEvent") then
                local name = obj.Name:lower()
                if name:find("kill") or name:find("damage") or name:find("eliminate") or name:find("die") or name:find("dead") or name:find("hit") then
                    table.insert(remotes, obj)
                end
            elseif obj:IsA("Folder") or obj:IsA("Model") then
                scanFolder(obj)
            end
        end
    end

    scanFolder(ReplicatedStorage)
    local map = workspace:FindFirstChild("Map") or workspace:FindFirstChild("Maps")
    if map then scanFolder(map) end

    return remotes
end

local function eliminatePlayer(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer or not targetPlayer.Character then return end
    
    task.defer(function()
        local character = targetPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        
        if character and humanoid then
            local remotes = getKillRemotes()
            for _, remote in ipairs(remotes) do
                pcall(function() remote:FireServer(targetPlayer) end)
                pcall(function() remote:FireServer(character) end)
                pcall(function() remote:FireServer(humanoid, 100) end)
            end
        end
    end)
end

local function killEveryoneNonBlocking()
    task.spawn(function()
        local targets = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                table.insert(targets, plr)
            end
        end

        local remotes = getKillRemotes()
        
        for i, targetPlayer in ipairs(targets) do
            if targetPlayer and targetPlayer.Character then
                local character = targetPlayer.Character
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                
                for _, remote in ipairs(remotes) do
                    pcall(function() remote:FireServer(targetPlayer) end)
                    pcall(function() remote:FireServer(character) end)
                    pcall(function() remote:FireServer(humanoid, 100) end)
                end
            end
            
            if i % 3 == 0 then
                task.wait(0.02)
            end
        end
    end)
end

local function executePushOnTarget(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer or not targetPlayer.Character then return end
    local localChar = LocalPlayer.Character
    if not localChar then return end

    local pushTool = localChar:FindFirstChild("Push") or LocalPlayer.Backpack:FindFirstChild("Push")
    if pushTool and pushTool:IsA("Tool") then
        local pushRemote = pushTool:FindFirstChildWhichIsA("RemoteEvent", true)
        if not pushRemote then
            pushRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Interact")
        end

        if pushRemote and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            pcall(function() pushRemote:FireServer(targetPlayer.Character) end)
            pcall(function() pushRemote:FireServer(targetPlayer) end)
            pcall(function() pushRemote:FireServer(targetPlayer.Character.HumanoidRootPart) end)
        end
    end
end


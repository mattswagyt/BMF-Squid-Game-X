-- Unified 60+ FPS ESP Render Loop
RunService.RenderStepped:Connect(function()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local tagKey = plr.Name

            -- Hide & Seek ESP
            if hideSeekESPEnabled then
                local teamColor = nil
                for _, acc in ipairs(char:GetChildren()) do
                    if acc:IsA("Accessory") then
                        if acc.Name == "Vest_blue" then
                            teamColor = Color3.fromRGB(0, 0, 255)
                        elseif acc.Name == "Vest_red" then
                            teamColor = Color3.fromRGB(255, 0, 0)
                        end
                    end
                end

                if teamColor then
                    highlightTarget(char, teamColor, "BMF_HideSeek_Highlight")
                    updateTracer(char, teamColor, tagKey .. "_HideSeek")
                    updateNameTag(char, plr.Name, teamColor)
                else
                    removeHighlight(char, "BMF_HideSeek_Highlight")
                    removeTracer(tagKey .. "_HideSeek")
                end
            else
                removeHighlight(char, "BMF_HideSeek_Highlight")
                removeTracer(tagKey .. "_HideSeek")
                removeNameTag(char)
            end

            -- Detective ESP
            if detectiveESPEnabled then
                if plr.Team and (plr.Team.Name == "Detective" or plr.Team == Teams:FindFirstChild("Detective")) then
                    highlightTarget(char, Color3.fromRGB(255, 215, 0), "BMF_Detective_Highlight")
                    updateNameTag(char, "[Detective] " .. plr.Name, Color3.fromRGB(255, 215, 0))
                else
                    removeHighlight(char, "BMF_Detective_Highlight")
                end
            else
                removeHighlight(char, "BMF_Detective_Highlight")
            end

            -- Guard ESP
            if guardESPEnabled then
                if plr.Team and (plr.Team.Name == "Guard" or plr.Team == Teams:FindFirstChild("Guard")) then
                    highlightTarget(char, Color3.fromRGB(255, 105, 180), "BMF_Guard_Highlight")
                    updateNameTag(char, "[Guard] " .. plr.Name, Color3.fromRGB(255, 105, 180))
                else
                    removeHighlight(char, "BMF_Guard_Highlight")
                end
            else
                removeHighlight(char, "BMF_Guard_Highlight")
            end

            -- Frontman ESP
            if frontmanESPEnabled then
                local isGuard = plr.Team and (plr.Team.Name == "Guard" or plr.Team == Teams:FindFirstChild("Guard"))
                local hasMask = char:FindFirstChild("Armour") and char.Armour:FindFirstChild("MASK")
                local hasRevolver = char:FindFirstChild("Revolver") or (plr:FindFirstChild("Backpack") and plr.Backpack:FindFirstChild("Revolver"))

                if isGuard and (hasMask or hasRevolver) then
                    highlightTarget(char, Color3.fromRGB(0, 0, 0), "BMF_Frontman_Highlight")
                    updateNameTag(char, "[FRONTMAN] " .. plr.Name, Color3.fromRGB(0, 0, 0))
                else
                    removeHighlight(char, "BMF_Frontman_Highlight")
                end
            else
                removeHighlight(char, "BMF_Frontman_Highlight")
            end
        end
    end
end)


local function cleanAnticheatRemotes()
    if not bypassAnticheatEnabled then return end
    pcall(function()
        -- RLGL Remotes
        local map = workspace:FindFirstChild("Map") or workspace:FindFirstChild("Maps")
        if map then
            local rlgl = map:FindFirstChild("RedLightGreenLight") or map:FindFirstChild("RedLightGreenLightLight")
            if rlgl and rlgl:FindFirstChild("Remotes") then
                rlgl.Remotes:Destroy()
            end
            
            -- Stage KillSecures & TouchZones
            if map:FindFirstChild("Glass") and map.Glass:FindFirstChild("Map") and map.Glass.Map:FindFirstChild("KillSecure") then
                map.Glass.Map.KillSecure:Destroy()
            end
            if map:FindFirstChild("JumpRope") and map.JumpRope:FindFirstChild("KillSecure") then
                map.JumpRope.KillSecure:Destroy()
            end
            if map:FindFirstChild("SkySquid") and map.SkySquid:FindFirstChild("KillSecure") then
                map.SkySquid.KillSecure:Destroy()
            end
            if map:FindFirstChild("SquidGame") and map.SquidGame:FindFirstChild("TouchZone") then
                map.SquidGame.TouchZone:Destroy()
            end
        end

        -- ReplicatedStorage KillSecures
        if ReplicatedStorage:FindFirstChild("Maps") then
            local rsMaps = ReplicatedStorage.Maps
            if rsMaps:FindFirstChild("Glass") and rsMaps.Glass:FindFirstChild("Map") and rsMaps.Glass.Map:FindFirstChild("KillSecure") then
                rsMaps.Glass.Map.KillSecure:Destroy()
            end
            if rsMaps:FindFirstChild("JumpRope") and rsMaps.JumpRope:FindFirstChild("KillSecure") then
                rsMaps.JumpRope.KillSecure:Destroy()
            end
            if rsMaps:FindFirstChild("SkySquid") and rsMaps.SkySquid:FindFirstChild("KillSecure") then
                rsMaps.SkySquid.KillSecure:Destroy()
            end
            if rsMaps:FindFirstChild("SquidGame") and rsMaps.SquidGame:FindFirstChild("TouchZone") then
                rsMaps.SquidGame.TouchZone:Destroy()
            end
        end
    end)
end

workspace.ChildAdded:Connect(function(child)
    if bypassAnticheatEnabled and (child.Name == "Map" or child.Name == "Maps") then
        task.wait(0.2)
        cleanAnticheatRemotes()
    end
end)

task.spawn(function()
    while true do
        task.wait(1.0)
        cleanAnticheatRemotes()
    end
end)


local function getRandomEligiblePlayer(teamFilter, accessoryFilter)
    local candidates = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local isCorrectTeam = true
            if teamFilter then
                isCorrectTeam = plr.Team and (plr.Team.Name == teamFilter or plr.Team == Teams:FindFirstChild(teamFilter))
            end

            local hasAccessory = true
            if accessoryFilter then
                hasAccessory = false
                for _, child in ipairs(plr.Character:GetChildren()) do
                    if child:IsA("Accessory") and child.Name == accessoryFilter then
                        hasAccessory = true
                        break
                    end
                end
            end

            if isCorrectTeam and hasAccessory then
                table.insert(candidates, plr)
            end
        end
    end

    if #candidates > 0 then
        return candidates[math.random(1, #candidates)]
    end
    return nil
end


        optionsFrame.Visible = not optionsFrame.Visible
        arrowButton.Text = optionsFrame.Visible and "v" or ">"
        
        if optionsFrame.Visible then
            entry.Size = UDim2.new(1, -10, 0, 185)
        else
            entry.Size = UDim2.new(1, -10, 0, 30)
        end
        refreshPlayersListCanvas()
    end)

    activePlayerEntries[player] = {
        EntryFrame = entry
    }

    -- Character death monitoring for auto-purge
    local function monitorCharacter(char)
        if char then
            local hum = char:WaitForChild("Humanoid", 5)
            if hum then
                hum.Died:Connect(function()
                    task.wait(1)
                    if not player.Character or not player.Character:FindFirstChild("Humanoid") or player.Character.Humanoid.Health <= 0 then
                        removePlayerEntry(player)
                    end
                end)
            end
        end
    end

    if player.Character then
        monitorCharacter(player.Character)
    end
    player.CharacterAdded:Connect(function(newChar)
        buildPlayerEntry(player)
    end)

    refreshPlayersListCanvas()
end


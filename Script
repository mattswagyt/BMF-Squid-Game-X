local function attachToPlayer(targetPlayer)
    attachedTarget = targetPlayer
    if attachConnection then
        attachConnection:Disconnect()
        attachConnection = nil
    end

    attachConnection = RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        local targetChar = targetPlayer.Character
        if char and targetChar and char:FindFirstChild("HumanoidRootPart") and targetChar:FindFirstChild("HumanoidRootPart") then
            local myHRP = char.HumanoidRootPart
            local targetHRP = targetChar.HumanoidRootPart
            local backOffset = targetHRP.CFrame * CFrame.new(0, 2, 3)
            myHRP.CFrame = backOffset
        end
    end)
end

local function unattachFromPlayer()
    attachedTarget = nil
    if attachConnection then

local ESP_Tracers = {}

local function highlightTarget(target, color, customName)
    local hlName = customName or "BMF_Highlight"
    local highlight = target:FindFirstChild(hlName)
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = hlName
        highlight.Adornee = target
        highlight.OutlineColor = Color3.fromRGB(255,255,255)
        highlight.FillTransparency = 0.4
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = target
    end
    highlight.FillColor = color
end

local function removeHighlight(target, customName)
    local hlName = customName or "BMF_Highlight"
    local highlight = target:FindFirstChild(hlName)
    if highlight then
        highlight:Destroy()
    end
end

local function updateTracer(target, color, tagKey)
    local camera = workspace.CurrentCamera
    if not ESP_Tracers[tagKey] then
        local line = Drawing.new("Line")
        line.Thickness = 2
        ESP_Tracers[tagKey] = line
    end

    local line = ESP_Tracers[tagKey]
    if target and target:FindFirstChild("HumanoidRootPart") then
        local hrp = target.HumanoidRootPart
        local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)

        if onScreen then
            line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
            line.To = Vector2.new(pos.X, pos.Y)
            line.Color = color
            line.Visible = true
        else
            line.Visible = false
        end
    else
        line.Visible = false
    end
end

local function removeTracer(tagKey)
    if ESP_Tracers[tagKey] then
        ESP_Tracers[tagKey].Visible = false
        ESP_Tracers[tagKey]:Remove()
        ESP_Tracers[tagKey] = nil
    end
end

